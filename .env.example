# Threads の鍵（scripts/set_token.py が書く。手で書かなくてよい）
# このファイルは見本。本物は .env（.gitignore 済み・GitHub には上がらない）
THREADS_ACCESS_TOKEN=
THREADS_USER_ID=

# コメントの分類（Jev）の鍵。どちらか1つ（scripts/set_jev_key.py が確かめて、.env と GitHub の Secrets に入れる）
TYPESAFE_API_KEY=
AI_GATEWAY_API_KEY=

# 返信案づくりの Claude（claude setup-token で作るサブスク用トークン）。scripts/set_claude_token.py が GitHub の Secrets に入れる
# 手元では書かなくてよい（手元の Claude Code は、そのログインで動く）
CLAUDE_CODE_OAUTH_TOKEN=
